# Local server configuration only. Copy to .env. Never commit actual secrets.
# Public/published CSV sources work without Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/integrations/google/callback
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable and back it up securely; it decrypts stored Google tokens.
SHEETS_ENCRYPTION_KEY=
SHEETS_SYNC_INTERVAL_MS=60000
DATA_DIR=.data
PORT=3001
# ENABLE_DEV_SESSION is set by npm run dev; production always rejects it.
